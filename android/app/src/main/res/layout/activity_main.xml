<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/bg_gradient"
    android:padding="32dp">

    <!-- Top bar: settings (left) + offline banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="⚙"
            android:textSize="20sp"
            android:textColor="@color/gold"
            android:background="@android:color/transparent"
            android:contentDescription="@string/settings" />

        <TextView
            android:id="@+id/tvOfflineBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/offline_mode"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:background="@color/red"
            android:gravity="center"
            android:padding="6dp"
            android:visibility="gone"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💰"
        android:textSize="72sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/gold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Who Wants To Be A Millionaire?"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_marginBottom="48dp" />

    <ProgressBar
        android:id="@+id/syncProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:indeterminateTint="@color/gold" />

    <TextView
        android:id="@+id/syncStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Syncing data..."
        android:textSize="14sp"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnPlay"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="PLAY"
        android:textSize="18sp"
        android:textColor="@color/dark_blue"
        android:background="@drawable/btn_primary"
        android:layout_marginBottom="12dp"
        android:enabled="false" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="LOGIN"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/btn_secondary"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnLeaderboard"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="LEADERBOARD"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/btn_secondary"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnProfile"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="PROFILE"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:background="@drawable/btn_secondary"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnGuest"
        android:layout_width="280dp"
        android:layout_height="48dp"
        android:text="Play as Guest"
        android:textSize="14sp"
        android:textColor="@color/gold"
        android:background="@android:color/transparent"
        android:layout_marginTop="8dp" />

</LinearLayout>
